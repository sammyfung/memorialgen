# Database dialect: sqlite | postgres | mariadb
NUXT_DB_DIALECT=sqlite

# SQLite file path (for sqlite dialect)
NUXT_DB_URL=./data/memorial.db

# PostgreSQL connection string (for postgres dialect)
# NUXT_DB_URL=postgres://user:password@localhost:5432/memorial

# MariaDB/MySQL connection string (for mariadb dialect)
# NUXT_DB_URL=mysql://user:password@localhost:3306/memorial

# Admin panel password
NUXT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Random 32+ character string for signing session cookies
NUXT_SESSION_SECRET=change-me-to-a-random-32-char-string

# Max upload size in MB (default: 5)
NUXT_UPLOAD_MAX_SIZE_MB=5

# ---- Static / GitHub Pages mode ----
# Set this to your API server URL when deploying frontend as static to GitHub Pages
# Leave empty when running as full-stack server
NUXT_PUBLIC_API_BASE_URL=

# Canonical site URL (used for OG tags)
NUXT_PUBLIC_SITE_URL=https://memorial.example.com

# ---- CORS (when running as separate API server for static mode) ----
NUXT_ALLOWED_ORIGIN=https://memorial.example.com
